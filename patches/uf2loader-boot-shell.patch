+// Patched for the PicoCalc shell (picocalc-shell, M7). A power-on gives the
+// shell, /BOOT2350.UF2, and Up/F1/F5 held the program in flash: the
+// stock modes swapped. After a program's own reboot with no command, the
+// program starts again, unless Up/F1/F5 is held through it. A command
+// from the shell or a program is read first and not kept waiting for a
+// key. The commands themselves are stock 2.5's.
+
+// How long a restart watches for a held key. A held key sends an event
+// every 100 ms.
+#define RESTART_WATCH_US 150000
+
+// The watchdog's REASON is zero after a hardware reset: a power-on, or the
+// RUN pin. POWMAN's CHIP_RESET is no help: a watchdog reboot leaves its
+// HAD_POR from the power-on before.
+static bool powered_on(void)
 {
-  // TODO: if keyboard isn't available, return BOOT_UPDATE
-  // so we can just do bootsel without having to turn the picocalc on
+  return watchdog_hw->reason == 0;
+}
 
-  init_i2c_kbd();
+// One event from the keyboard's FIFO: the state (1 pressed, 2 held, 3
+// released) in the low byte and the key in the high, 0 when it is empty,
+// -1 on a bus error. Unlike read_i2c_kbd(), it keeps held events.
+static int kbd_event(void)
+{
+  uint8_t reg = 0x09;
+  uint8_t r[2];
 
+  if (i2c_write_timeout_us(I2C_KBD_MOD, I2C_KBD_ADDR, &reg, 1, false, 20000) != 1 ||
+      i2c_read_timeout_us(I2C_KBD_MOD, I2C_KBD_ADDR, r, 2, false, 20000) != 2)
+  {
+    return -1;
+  }
+  return r[0] | r[1] << 8;
+}
+
+// At a power-on.
+enum bootmode_e read_bootmode()
+{
   int key;
   int end_time = time_us_32() + 500000; // 0.5s
 
@@ -108,6 +140,41 @@ enum bootmode_e read_bootmode()
   {
     key = read_i2c_kbd();
     switch (key)
+    {
+      case KEY_UP:
+      case KEY_F1:
+      case KEY_F5:
+        return BOOT_DEFAULT;
+      case KEY_DOWN:
+      case KEY_F3:
+        return BOOT_UPDATE;
+      default:
+        break;
+    }
+  }
+
+  return BOOT_SD;
+}
+
+// After any other reset with no command.
+enum bootmode_e read_restart_keys(void)
+{
+  // Drop what the program left unread: a key pressed in it is no request.
+  for (int i = 0; i < 32 && kbd_event() > 0; i++)
+  {
+  }
+
+  int end_time = time_us_32() + RESTART_WATCH_US;
+
+  while (((int)time_us_32() - end_time) < 0)
+  {
+    int event = kbd_event();
+    int state = event & 0xff;
+    if (event <= 0 || (state != 1 && state != 2))
+    {
+      continue;
+    }
+    switch (event >> 8)
     {
       case KEY_UP:
       case KEY_F1:
@@ -134,9 +201,11 @@ int main()
 
